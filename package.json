{
  "name": "dsh-config-pack",
  "version": "0.10.13",
  "private": false,
  "type": "module",
  "description": "A generic, git-distributable DSH configuration pack: plugin selection + profile config layer + agent presets, installable into any DSH profile with one command.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "cordis.patch.yml",
    "config",
    "examples",
    "pack.manifest.yaml",
    "packages",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "scripts",
    "docs",
    "templates"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs && npm run verify:ptc-public && npm run verify:components:offline",
    "verify:components": "node scripts/verify-components.mjs",
    "verify:components:offline": "node scripts/verify-components.mjs --offline",
    "verify:ptc-public": "node scripts/verify-ptc-public-template.mjs",
    "compare": "node scripts/compare-profile.mjs",
    "metrics": "node scripts/metrics.mjs",
    "metrics:scan": "node scripts/metrics.mjs scan --sessions",
    "metrics:stats": "node scripts/metrics.mjs stats --sessions",
    "metrics:selftest": "node scripts/metrics.mjs selftest",
    "test": "npm run test:ptc-public && node scripts/test-model-config.mjs",
    "test:backup": "pwsh -NoProfile -File scripts/test-backup.ps1",
    "test:ptc-public": "node scripts/test-ptc-public-template.mjs",
    "ptc:generate": "node scripts/generate-ptc-companion.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent-acp": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent-claude-code": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent-codex": "0.2.0-rc.2",
    "dsh-chat-import": "0.25.2",
    "dsh-mermaid-smooth": "0.1.0",
    "dsh-notify-bell": "0.12.0",
    "dsh-deepseek-keypool": "github:Robert-Wang-08/dsh-provider-failover#v3.6.0",
    "dsh-plugin-provider-badge": "github:Robert-Wang-08/dsh-plugin-provider-badge#v0.3.1",
    "dsh-plugin-sidebar-visibility": "github:Robert-Wang-08/dsh-plugin-sidebar-visibility#v0.0.7",
    "dsh-archived-sessions": "github:Robert-Wang-08/dsh-archived-sessions#v0.4.2",
    "dsh-plugin-subagent-monitor": "github:Robert-Wang-08/dsh-plugin-subagent-monitor#v0.1.0",
    "@local/dsh-subagent-acp-resilient": "github:Robert-Wang-08/dsh-subagent-acp-resilient#v0.2.2",
    "fzstd": "^0.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robert-Wang-08/dsh-config-pack.git"
  }
}
