{
  "schema_version": "ptc-public-runtime/v1",
  "controller": {
    "provider": "codex-relay",
    "model": "gpt-6.1-sol",
    "effort": "high",
    "fallbackProvider": "openai-codex",
    "fallbackModel": "gpt-5.6-sol"
  },
  "execute": {
    "provider": "ais-2dsglm",
    "model": "deepseek-v4.1-flash"
  },
  "continuous": {
    "provider": "ais-2dsglm",
    "model": "glm-5.3-flash",
    "executor": "subagent",
    "note": "同一代码面 2–5 文件连续修改（R7）。2026-10-16 用户指定：不再走 Cursor/Grok ACP，改用 ais-2dsglm 的 GLM；该 provider 上唯一的 GLM 档是 glm-5.3-flash。"
  },
  "docs": {
    "provider": "kimi-coding",
    "model": "kimi-code/k3-256k"
  },
  "design": {
    "astraProvider": "codex-relay",
    "astraModel": "gpt-6.1-sol",
    "effort": "xhigh",
    "astraExecutor": "subagent_codex_astra",
    "opusProvider": "anthropic-relay",
    "opusModel": "claude-opus-5",
    "opusExecutor": "subagent_claude_opus55_plan",
    "opusUnavailableAction": "report_opus_unavailable",
    "opusLadder": [
      {
        "provider": "tokeniss",
        "model": "claude-opus-5-5",
        "executor": "subagent_claude_opus55_plan",
        "note": "由 tokeniss 配置目录提供；2026-10-15 实测 CLI 层成功"
      },
      {
        "provider": "anthropic-relay",
        "model": "claude-opus-5",
        "executor": "subagent_claude_opus5_plan",
        "note": "由 relay 配置目录提供；2026-10-15 实测 CLI 层成功"
      },
      {
        "provider": "anthropic-relay",
        "model": "claude-opus-4-8",
        "executor": "subagent_claude_opus5_plan",
        "note": "同一个 5 档执行档，需把 PTC_CLAUDE_OPUS5_MODEL 设为 claude-opus-4-8 才能执行该档（设备启动期开关，不能与上一档同时生效）"
      }
    ],
    "opusLadderNote": "按首条命中降级：5.5 -> 5 -> 4.8；三档都不可用时如实报告 Opus 不可用，不自动改用 Sonnet（relay 对不可用模型会直接返回 403，可据此判定）。provider 列表是时间点快照，使用前应重新核验。",
    "opusExecutorCoupling": "两个执行档各绑一个独立 Claude Code 配置目录（CLAUDE_CONFIG_DIR）。之所以不能用 env 分后端：Claude Code 的 settings.json 里 env 优先级高于进程环境（2026-10-15 实测无效 token 仍成功）。配置目录由 scripts/claude_config_profiles.py 预置，含凭据，属设备本地状态。执行档不读路由梯子的 provider/model 字段，梯子只决定候选顺序与派发记录。",
    "opusExecutors": {
      "five_five": {
        "tool": "subagent_claude_opus55_plan",
        "providerName": "claude-opus55-plan",
        "defaultModel": "claude-opus-5-5",
        "configDirEnv": "PTC_CLAUDE_OPUS55_CONFIG_DIR",
        "defaultConfigDir": "~/.claude-profiles/tokeniss"
      },
      "five": {
        "tool": "subagent_claude_opus5_plan",
        "providerName": "claude-opus5-plan",
        "defaultModel": "claude-opus-5",
        "configDirEnv": "PTC_CLAUDE_OPUS5_CONFIG_DIR",
        "defaultConfigDir": "~/.claude-profiles/relay"
      }
    }
  }
}
