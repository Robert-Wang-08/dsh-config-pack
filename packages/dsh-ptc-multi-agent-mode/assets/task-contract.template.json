{
  "schema_version": "1.0",
  "contract_name": "ptc-multi-agent-default",
  "objective_guard": "任务目标创建后不可静默改变；实质变更创建新根任务",
  "deliverables": [
    {
      "id": "implementation",
      "kind": "code-or-config",
      "path_pattern": "由任务创建者填写明确的仓库相对路径",
      "format": "按任务预设",
      "required": true,
      "acceptance": [
        "内容与冻结目标一致",
        "通过任务约定的定点验证",
        "没有越过授权写入范围"
      ]
    },
    {
      "id": "documentation",
      "kind": "document",
      "path_pattern": "由任务创建者填写明确的仓库相对路径",
      "format": "Markdown UTF-8",
      "required": true,
      "acceptance": [
        "包含目标、用法、验证、限制和下一步",
        "完成结论绑定最新证据"
      ]
    }
  ],
  "worker_output": {
    "format": "JSON",
    "schema": "<SKILL_ROOT>/assets/worker-receipt.schema.json"
  },
  "final_response_sections": [
    "根任务与目标",
    "完成项及作用",
    "实际模型路由与降级",
    "产出物",
    "验证证据",
    "限制与下一步唯一动作"
  ],
  "invariants": [
    "controller_only_writes_ledger",
    "one_root_task_per_session",
    "workers_return_receipts",
    "review_and_done_require_evidence",
    "done_requires_progress_100"
  ]
}
