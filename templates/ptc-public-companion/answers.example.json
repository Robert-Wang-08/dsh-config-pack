{
  "schema_version": "ptc-public-answers/v1",
  "provider": {
    "controller": "codex-relay",
    "controllerModel": "gpt-6.1-sol",
    "controllerEffort": "high",
    "fallbackProvider": "openai-codex",
    "fallbackModel": "gpt-6.1-sol",
    "executeProvider": "ais-2dsglm",
    "executeModel": "deepseek-v4.1-flash",
    "continuousProvider": "ais-2dsglm",
    "continuousModel": "glm-5.3-flash",
    "docsProvider": "kimi-coding",
    "docsModel": "kimi-code/k3-256k",
    "designAstraProvider": "codex-relay",
    "designAstraModel": "gpt-6.1-sol",
    "designEffort": "xhigh",
    "designFiveFiveProvider": "tokeniss",
    "designFiveFiveModel": "claude-opus-5-5",
    "designModel": "claude-opus-5",
    "designLegacyModel": "claude-opus-4-8"
  },
  "cli": {
    "opencode": {
      "pathEnv": "PTC_CLI_OPENCODE",
      "defaultCommand": "opencode"
    },
    "cursor": {
      "pathEnv": "PTC_CLI_CURSOR",
      "defaultCommand": "cursor-agent"
    },
    "kimi": {
      "pathEnv": "PTC_CLI_KIMI",
      "defaultCommand": "kimi"
    }
  },
  "proxy": {
    "enabled": false,
    "urlEnv": "HTTPS_PROXY",
    "noProxyEnv": "NO_PROXY",
    "keepCursorProxy": false
  },
  "features": {
    "opencode": true,
    "kimiDocs": true,
    "cursor": false,
    "claudePlan": true,
    "presentation": true
  },
  "acpPlugin": "resilient"
}
