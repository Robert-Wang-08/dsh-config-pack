# Generated by generate-ptc-companion.mjs. Keep this file in a local never-sync directory.
# Apply after the generated dsh-bundle. Values are defaults plus environment-variable references.

- id: subagent-acp-opencode-dsv41
  name: '@deepseek-ai/dsh-subagent-acp'
  disabled: !!js process['env'].PTC_FEATURE_OPENCODE === 'off'
  config:
    providerName: opencode-dsv41
    command: !!js (process.platform === 'win32' && 'cmd') || 'sh'
    args:
      - !!js (process.platform === 'win32' && '/c') || '-c'
      - !!js process['env'].PTC_OPENCODE_ACP || ((process.platform === 'win32' && ((process['env']["PTC_CLI_OPENCODE"] || "opencode") + ' acp')) || ('exec ' + (process['env']["PTC_CLI_OPENCODE"] || "opencode") + ' acp'))
    permission: allow
    env:
      OPENCODE_CONFIG_CONTENT: !!js process['env']["PTC_OPENCODE_CONFIG_CONTENT"] || "{\"model\":\"ais1dsglm/deepseek-v4.1-flash\"}"

- id: subagent-acp-kimi-docs
  name: '@deepseek-ai/dsh-subagent-acp'
  disabled: !!js process['env'].PTC_FEATURE_KIMI_DOCS === 'off'
  config:
    providerName: kimi-docs
    command: !!js process['env']["PTC_CLI_KIMI"] || "kimi"
    args:
      - '--model'
      - !!js process['env']["PTC_KIMI_DOCS_MODEL"] || "kimi-code/k3-256k"
      - acp
    permission: allow

- id: subagent-acp-cursor-grok
  name: '@deepseek-ai/dsh-subagent-acp'
  disabled: !!js process['env'].PTC_FEATURE_CURSOR !== 'on'
  config:
    providerName: cursor-grok
    command: !!js (process.platform === 'win32' && 'cmd') || 'sh'
    args:
      - !!js (process.platform === 'win32' && '/c') || '-c'
      - !!js process['env'].PTC_CURSOR_ACP || ((process.platform === 'win32' && ((process['env']["PTC_CLI_CURSOR"] || "cursor-agent") + ' --model auto acp')) || ('exec ' + (process['env']["PTC_CLI_CURSOR"] || "cursor-agent") + ' --model auto acp'))
    permission: allow
    env:
      no_proxy: !!js (process['env']["NO_PROXY"] || '').split(',').concat('cursor.sh').filter(Boolean).join(',')

- id: subagent-claude-opus55-plan
  name: '@deepseek-ai/dsh-subagent-claude-code'
  disabled: !!js process['env'].PTC_FEATURE_CLAUDE_PLAN === 'off'
  config:
    providerName: claude-opus55-plan
    model: !!js process['env']["PTC_CLAUDE_OPUS55_MODEL"] || "claude-opus-5-5"
    permissionMode: plan
    env:
      CLAUDE_CONFIG_DIR: !!js process['env']["PTC_CLAUDE_OPUS55_CONFIG_DIR"] || (((process['env']["USERPROFILE"] || process['env']["HOME"] || "") + "/.claude-profiles/tokeniss"))

- id: subagent-claude-opus5-plan
  name: '@deepseek-ai/dsh-subagent-claude-code'
  disabled: !!js process['env'].PTC_FEATURE_CLAUDE_PLAN === 'off'
  config:
    providerName: claude-opus5-plan
    model: !!js process['env']["PTC_CLAUDE_OPUS5_MODEL"] || "claude-opus-5"
    permissionMode: plan
    env:
      CLAUDE_CONFIG_DIR: !!js process['env']["PTC_CLAUDE_OPUS5_CONFIG_DIR"] || (((process['env']["USERPROFILE"] || process['env']["HOME"] || "") + "/.claude-profiles/relay"))
