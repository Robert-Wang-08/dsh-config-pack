{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-config-pack:ptc-public-answers:v1",
  "title": "PTC public companion answers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "cli",
    "proxy",
    "features",
    "acpPlugin"
  ],
  "properties": {
    "schema_version": {
      "const": "ptc-public-answers/v1"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "controllerModel",
        "controllerEffort",
        "fallbackProvider",
        "fallbackModel",
        "executeProvider",
        "executeModel",
        "docsProvider",
        "docsModel",
        "designAstraProvider",
        "designAstraModel",
        "designFiveFiveProvider",
        "designFiveFiveModel",
        "designModel",
        "designLegacyModel"
      ],
      "properties": {
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "controllerModel": {
          "type": "string",
          "minLength": 1
        },
        "controllerEffort": {
          "enum": [
            "low",
            "high",
            "max"
          ]
        },
        "fallbackProvider": {
          "type": "string",
          "minLength": 1
        },
        "fallbackModel": {
          "type": "string",
          "minLength": 1
        },
        "executeProvider": {
          "type": "string",
          "minLength": 1
        },
        "executeModel": {
          "type": "string",
          "minLength": 1
        },
        "docsProvider": {
          "type": "string",
          "minLength": 1
        },
        "docsModel": {
          "type": "string",
          "minLength": 1
        },
        "designAstraProvider": {
          "type": "string",
          "minLength": 1
        },
        "designAstraModel": {
          "type": "string",
          "minLength": 1
        },
        "designFiveFiveProvider": {
          "type": "string",
          "minLength": 1
        },
        "designFiveFiveModel": {
          "type": "string",
          "minLength": 1
        },
        "designModel": {
          "type": "string",
          "minLength": 1
        },
        "designLegacyModel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cli": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opencode",
        "cursor",
        "kimi"
      ],
      "properties": {
        "opencode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pathEnv",
            "defaultCommand"
          ],
          "properties": {
            "pathEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "defaultCommand": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pathEnv",
            "defaultCommand"
          ],
          "properties": {
            "pathEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "defaultCommand": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        },
        "kimi": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pathEnv",
            "defaultCommand"
          ],
          "properties": {
            "pathEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "defaultCommand": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "urlEnv",
        "noProxyEnv",
        "keepCursorProxy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "urlEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "noProxyEnv": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "keepCursorProxy": {
          "type": "boolean"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opencode",
        "kimiDocs",
        "cursor",
        "claudePlan",
        "presentation"
      ],
      "properties": {
        "opencode": {
          "type": "boolean"
        },
        "kimiDocs": {
          "type": "boolean"
        },
        "cursor": {
          "type": "boolean"
        },
        "claudePlan": {
          "type": "boolean"
        },
        "presentation": {
          "type": "boolean"
        }
      }
    },
    "acpPlugin": {
      "description": "Which subagent plugin backs the three ACP provider rows. resilient is the public default and uses the public Git-distributed resilient package; upstream remains available as a compatibility option. Selecting resilient also emits the graded timeout ladder as PTC_ACP_* environment overrides, because those keys are silently inert under the upstream plugin.",
      "enum": [
        "upstream",
        "resilient"
      ]
    }
  }
}
