{
  "schema_version": "ptc-public-runtime/v1",
  "controller": {
    "provider": "codex-relay",
    "model": "gpt-5.6-sol",
    "effort": "high",
    "fallbackProvider": "openai-codex",
    "fallbackModel": "gpt-5.6-sol"
  },
  "execute": {
    "provider": "ais-2dsglm",
    "model": "deepseek-v4.1-flash"
  },
  "docs": {
    "provider": "kimi-coding",
    "model": "kimi-code/k3-256k"
  },
  "design": {
    "astraProvider": "codex-relay",
    "astraModel": "gpt-6-astra",
    "astraExecutor": "subagent_codex_astra",
    "opusProvider": "anthropic-relay",
    "opusModel": "claude-opus-5",
    "opusExecutor": "subagent_claude_opus55_plan",
    "opusUnavailableAction": "report_opus_unavailable",
    "opusLadder": [
      {
        "provider": "tokeniss",
        "model": "claude-opus-5-5",
        "executor": "subagent_claude_opus55_plan",
        "note": "5.5 档；由该 provider 的 Claude Code 配置目录提供，使用前须核验该来源在售并回显同一 model id"
      },
      {
        "provider": "anthropic-relay",
        "model": "claude-opus-5",
        "executor": "subagent_claude_opus5_plan",
        "note": "5 档；由 relay 配置目录提供"
      },
      {
        "provider": "anthropic-relay",
        "model": "claude-opus-4-8",
        "executor": "subagent_claude_opus5_plan",
        "note": "与上一档共用 5 档执行档，需把 PTC_CLAUDE_OPUS5_MODEL 设为该 id 才能执行（设备启动期开关，不能与上一档同时生效）"
      }
    ],
    "opusLadderNote": "按首条命中降级：5.5 -> 5 -> 4.8；三档都不可用时如实报告 Opus 不可用，不自动改用 Sonnet。provider 列表是时间点快照，使用前应重新核验。",
    "opusExecutorCoupling": "两个执行档各绑一个独立 Claude Code 配置目录（CLAUDE_CONFIG_DIR）。不能用环境变量分后端：Claude Code 的 settings.json 里 env 优先级高于进程环境，实测无效凭据仍会成功。配置目录含各来源凭据，属设备本地状态，不入库。执行档自身不读路由梯子的 provider/model；切档靠配置目录与 PTC_CLAUDE_OPUS5_MODEL。",
    "opusExecutors": {
      "five_five": {
        "tool": "subagent_claude_opus55_plan",
        "providerName": "claude-opus55-plan",
        "defaultModel": "claude-opus-5-5",
        "configDirEnv": "PTC_CLAUDE_OPUS55_CONFIG_DIR",
        "defaultConfigDir": "~/.claude-profiles/tokeniss"
      },
      "five": {
        "tool": "subagent_claude_opus5_plan",
        "providerName": "claude-opus5-plan",
        "defaultModel": "claude-opus-5",
        "configDirEnv": "PTC_CLAUDE_OPUS5_CONFIG_DIR",
        "defaultConfigDir": "~/.claude-profiles/relay"
      }
    }
  }
}
