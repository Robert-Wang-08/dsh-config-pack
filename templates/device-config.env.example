# dsh-config-pack device template
# Copy this file OUTSIDE the Git repository into a SkillHub-managed personal/private file.
# Replace values for this device, then export them as User environment variables before starting DSH.
# This file contains pointers and non-secret preferences only. Never put raw API keys here.

# Executables and absolute paths
DSHPACK_NODE=node
DSHPACK_TICKTICK_ENTRY=<ABSOLUTE_PATH_TO_TICKTICK_MCP_DIST_INDEX_JS>
DSHPACK_CODEGRAPH_CMD=<COMMAND_OR_ABSOLUTE_PATH>

# Human-switchable defaults
DSHPACK_DEFAULT_PROVIDER=codex-relay
DSHPACK_DEFAULT_MODEL=gpt-5.6-sol
DSHPACK_SELECTED_PRESET=ptc-multi-agent

# Feature switches
DSHPACK_ACP_OPENCODE=on
DSHPACK_ACP_KIMI=on
DSHPACK_ACP_CURSOR=off
DSHPACK_MCP_CODEGRAPH=off
DSHPACK_MCP_TENCENT_DOCS=off
DSHPACK_MCP_SLIDE=off
DSHPACK_CURSOR_KEEP_PROXY=

# Provider endpoints (device/network specific)
DSHPACK_BASE_CODEX_RELAY=<BASE_URL>
DSHPACK_BASE_AIS=<BASE_URL>
DSHPACK_BASE_ANTHROPIC_RELAY=<BASE_URL>

# Key pointers only: values are ENVIRONMENT VARIABLE NAMES, not secrets
DSHPACK_KEY_CODEX_RELAY=CRS_OAI_KEY
DSHPACK_KEY_AIS=AIS_2DSGLM_API_KEY
DSHPACK_KEY_ANTHROPIC_RELAY=CLAUDE_RELAY_TOKEN
DSHPACK_KEY_KIMI=LLMKEY_KIMI
DSHPACK_KEY_OPENCODE=OPENCODE_API_KEY

# Failover route ids. Override when a device uses another route id (for example opencodego).
DSHPACK_ROUTE_CODEX_RELAY=codex-relay
DSHPACK_ROUTE_OPENAI_CODEX=openai-codex
DSHPACK_ROUTE_AIS=ais-2dsglm
DSHPACK_ROUTE_OPENCODE=opencode-go
DSHPACK_ROUTE_KIMI=kimi-coding
DSHPACK_ROUTE_DEEPSEEK_OFFICIAL=deepseek-official

# Optional raw JSON passed to OpenCode ACP. Keep empty unless this device needs an override.
DSHPACK_OPENCODE_CONFIG=
